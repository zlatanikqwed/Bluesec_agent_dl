# Пример конфигурации. Скопировать в .env и вписать свои значения.
# .env в репозиторий не коммитить (он в .gitignore).

# --- Платформа BlueSec ---
SCENARIO_RUNTIME_ENDPOINT=bluesec.team:443
SCENARIO_RUNTIME_TOKEN=replace-with-runtime-token
SCENARIO_RUNTIME_VERIFY_TLS=true
# practice – открытый этап (30 задач), graded – закрытый (40 задач).
# Если не задано, арену выбирает сервер; можно передать --arena в CLI.
# SCENARIO_RUNTIME_ARENA=practice
GRPC_DNS_RESOLVER=native
REMOTE_RUN_LABEL=my-agent
AGENT_NAME=my-agent

# --- Основная модель (OpenAI-совместимый API) ---
# В финальной конфигурации: openai/gpt-oss-20b в LM Studio,
# LLM_BASE_URL=http://localhost:1234/v1
LLM_BASE_URL=https://provider.example/v1
LLM_API_KEY=replace-with-your-key
LLM_DEFAULT_MODEL=provider/model-name
LLM_HTTP_RETRIES=3
LLM_MIN_INTERVAL_SECONDS=2
LLM_TIMEOUT_SECONDS=600
LLM_MAX_COMPLETION_TOKENS=8192
LLM_MAX_STEP_RETRIES=3
LLM_EXTRA_BODY='{"temperature":0,"seed":42}'
LLM_DISABLE_THINKING=false
LLM_INLINE_SCHEMA_REFS=true

# --- Арбитр (крупная модель, только для спорных вердиктов) ---
# Пустой LLM_ARBITER_MODEL = арбитр выключен, арбитраж делает основная модель.
# Пустые BASE_URL и API_KEY берутся из LLM_*.
LLM_ARBITER_MODEL=nvidia/nemotron-3-ultra-550b-a55b
LLM_ARBITER_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_ARBITER_API_KEY=replace-with-arbiter-key
LLM_ARBITER_MAX_COMPLETION_TOKENS=8192
LLM_ARBITER_INLINE_SCHEMA_REFS=true
LLM_ARBITER_EXTRA_BODY='{"temperature":0}'
# schema | json_object | none
LLM_ARBITER_RESPONSE_MODE=schema
# true – основная модель отвечает параллельно, ее вердикт только пишется в траекторию
LLM_ARBITER_SHADOW=true

# --- Агент ---
BLUESEC_AGENT_MAX_STEPS=26
BLUESEC_AGENT_CONTEXT_CHARS=12000
BLUESEC_AGENT_KEEP_RECENT_RESULTS=6
BLUESEC_AGENT_MIN_ENTITIES_BEFORE_BENIGN=2
BLUESEC_AGENT_GPT_OSS_MODE=true
BLUESEC_AGENT_REVIEW_ENABLED=true
BLUESEC_AGENT_HARVEST_MODE=true
BLUESEC_AGENT_HARVEST_BUDGET=8
BLUESEC_AGENT_HARVEST_RESEARCH=false
BLUESEC_AGENT_REPORT_EXPERIMENT=role_policy
BLUESEC_AGENT_TRAJECTORY_DIR=runs
